{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Tên Worker trên Cloudflare — phải trùng với tên dự án Cloudflare và với "service" bên dưới
  "name": "du-hoc-ngoc-lam-anh",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-16",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Worker tự gọi lại chính nó (OpenNext dùng khi làm mới trang) — tên phải trùng "name" ở trên
      "binding": "WORKER_SELF_REFERENCE",
      "service": "du-hoc-ngoc-lam-anh"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
